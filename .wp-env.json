{
  "$schema": "https://schemas.wp.org/trunk/wp-env.json",
  "core": "https://wordpress.org/wordpress-7.0.4.zip",
  "phpVersion": "8.3",
  "env": {
    "development": {
      "plugins": [
        ".",
        "https://downloads.wordpress.org/plugin/daggerhart-openid-connect-generic.zip"
      ],
      "themes": [],
      "mappings": {
        "wp-content/mu-plugins/oidc-test-helper.php": "./test-fixtures/oidc-test-helper.php",
        "wp-content/mu-plugins/oidc-token-failure.php": "./test-fixtures/oidc-token-failure.php"
      },
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "WP_MEMORY_LIMIT": "512M"
      }
    },
    "tests": {
      "plugins": [
        "https://downloads.wordpress.org/plugin/openid-connect-server.zip"
      ],
      "themes": [],
      "config": {
        "WP_DEBUG": true,
        "WP_DEBUG_DISPLAY": true,
        "WP_DEBUG_LOG": true,
        "WP_MEMORY_LIMIT": "512M"
      },
      "mappings": {
        "wp-content/oidc-keys": "./.oidc-keys",
        "wp-content/mu-plugins/oidc-keys-loader.php": "./.oidc-keys/oidc-keys-loader.php",
        "wp-content/mu-plugins/oidc-laravel-claims.php": "./test-fixtures/oidc-laravel-claims.php",
        "wp-content/mu-plugins/oidc-test-client.php": "./test-fixtures/oidc-test-client.php"
      }
    }
  },
  "lifecycleScripts": {
    "afterStart": "bash .wp-env-setup.sh"
  }
}
